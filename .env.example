# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workflow_management
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_very_secure_random_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Payment Configuration (Optional)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key
DEFAULT_CURRENCY=USD
DEFAULT_POST_PAYMENT=50.00

# Daily blog-post indexer (team keyword search). Set to false to disable.
POST_INDEXER_ENABLED=true
# Hour of day (server time) for the daily run
POST_INDEXER_HOUR=2


# Marketplace (white-label) – PayPal wallet top-ups. Sandbox = test money; set PAYPAL_MODE=live only at go-live.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
# Marketplace brand used in its emails (set when the name/domain is decided)
MARKETPLACE_WHITELABEL_NAME=Link Marketplace
MARKETPLACE_WHITELABEL_URL=http://localhost:5175
# MARKETPLACE_WHITELABEL_FROM_EMAIL=hello@your-marketplace-domain.com

# AI suggestions for writers' Niche Edit orders (OpenAI)
OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-5.4-mini                 # any chat model your key can use
# NICHE_SUGGEST_DAILY_LIMIT_USD=2           # stop AI calls for the day once this much is spent

# Client accounts can't log in to the dashboard while this is not "true"
# CLIENT_LOGIN_ENABLED=true

# Marketplace storefront API (/api/marketplace). Off unless "true".
# MARKETPLACE_ENABLED=true
